# Data source — switch with this one line:
#   mock = sample stations around Darmstadt with simulated prices (no key needed)
#   live = real Tankerkönig API (needs TANKERKOENIG_API_KEY)
# Unset: live when a key is set; in `npm run dev` without a key, mock.
TANKERKOENIG_MODE=mock

# Tankerkönig API key (free): https://onboarding.tankerkoenig.de
# Server-side only. Never expose this to the client.
TANKERKOENIG_API_KEY=
